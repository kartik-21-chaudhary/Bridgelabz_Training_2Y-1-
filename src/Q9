public class Main {

    public static boolean checkEqual(String s1, String s2, int index) {

        if (index == s1.length()) {
            return true;
        }

        if (s1.charAt(index) != s2.charAt(index)) {
            return false;
        }

        return checkEqual(s1, s2, index + 1);
    }

    public static void main(String[] args) {

        String s1 = "hello";
        String s2 = "hello";

        if (s1.length() != s2.length()) {
            System.out.println(false);
        } else {
            System.out.println(checkEqual(s1, s2, 0));
        }
    }
}
