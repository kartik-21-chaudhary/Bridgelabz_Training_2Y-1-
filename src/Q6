public class Main {

    public static String removeCharacter(String name, int index, char target) {

        if (index == name.length()) {
            return "";
        }

        char ch = name.charAt(index);

        if (ch == target) {
            return removeCharacter(name, index + 1, target);
        }

        return ch + removeCharacter(name, index + 1, target);
    }

    public static void main(String[] args) {

        String name = "banana";

        System.out.println(removeCharacter(name, 0, 'a'));
    }
}
